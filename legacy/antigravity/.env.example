# HoldLine environment variables.
#
# Copy to `.env` and fill in what you need. Every variable here has a working
# default except the credentials, which are required only from the phase that
# introduces them. `config.validate_startup()` fails at boot with the name of
# anything missing -- never with its value.

# ---------------------------------------------------------------------------
# Phase 1: nothing here is required. A clean clone runs on the defaults.
# ---------------------------------------------------------------------------

# Where the SQLite database lives. Default: ./data/holdline.db
# HOLDLINE_DB_PATH=./data/holdline.db

# Directory for generated data. Git-ignored. Default: ./data
# HOLDLINE_DATA_DIR=./data

# The single location the application serves.
# HOLDLINE_LOCATION_ID=marchetti_lincoln_park

# HTTP bind address and port. Use 0.0.0.0 behind a tunnel or on Render/Railway.
# HOLDLINE_HOST=127.0.0.1
# HOLDLINE_PORT=8000

# DEBUG | INFO | WARNING | ERROR
# HOLDLINE_LOG_LEVEL=INFO

# true emits JSON lines (use this anywhere but a developer terminal).
# HOLDLINE_LOG_JSON=false

# How long SQLite waits for the write lock before giving up, in milliseconds.
# HOLDLINE_DB_BUSY_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Policy thresholds. Documented in src/holdline/config.py with the reasoning
# for each default. Override only with a reason.
# ---------------------------------------------------------------------------

# Age past which the assistant refuses to state any quantity, in seconds.
# STALE_THRESHOLD_SECONDS=600

# Grace window past the stated pickup time before a hold expires, in minutes.
# DEFAULT_HOLD_MINUTES=45

# Above this quantity, a human approves the hold.
# MAX_AUTO_APPROVE_QTY=2

# Pickups further ahead than this need a human, in hours.
# MAX_HOLD_HOURS_AHEAD=4

# Quantity that triggers the "big order" conversation path.
# LARGE_ORDER_QTY=6

# How long an unanswered approval request keeps holding stock, in minutes.
# PENDING_APPROVAL_TTL_MINUTES=30

# Retries after a tier-1 grounding violation. Tier 2 never retries, at any value.
# GUARDRAIL_MAX_RETRIES=1

# Runaway protection for the tool-use loop.
# AGENT_MAX_TOOL_LOOPS=5

# Hard timeout on a single model call, in seconds.
# LLM_TIMEOUT_SECONDS=20

# NOTE: there is deliberately no variable for ALLERGY_ALWAYS_ESCALATE. It is a
# constant in code. Shipping an off switch for that rule is not a feature.

# ---------------------------------------------------------------------------
# Phase 3 onward: required. https://console.anthropic.com/
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Phase 5: optional tracing. https://smith.langchain.com/ (free tier)
# ---------------------------------------------------------------------------

# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=holdline

# Which agent implementation to run: manual | graph
# HOLDLINE_AGENT_IMPL=graph

# ---------------------------------------------------------------------------
# Phase 6: the phone layer. Leave unset and the browser demo works standalone.
# ---------------------------------------------------------------------------

# VAPI_API_KEY=

# Public HTTPS base URL the voice platform calls back on (ngrok, Render, Railway).
# It must point at the VOICE-ONLY app: python -m holdline.run --voice
# HOLDLINE_PUBLIC_BASE_URL=

# Shared secret proving a webhook came from the platform. Optional, and the app logs
# a warning on every unverified request when it is unset. Set it before the number is
# public: /api/voice/tool writes to the ledger, so without it anyone who finds the
# tunnel can reserve stock.
# VAPI_WEBHOOK_SECRET=

# Copy to .env and fill in. Never commit .env.

# Required only for live conversations and `python -m evals.run_evals --record`.
# Tests and `--replay` (the default) make zero API calls.
ANTHROPIC_API_KEY=

# Model used for the agent and for reported eval numbers. Chosen for cost:
# the eval harness budget is about $20 total.
HOLDLINE_MODEL=claude-sonnet-5-5
# Cheaper model for the 8-scenario smoke run (`--smoke`).
HOLDLINE_SMOKE_MODEL=claude-haiku-5-5

# Path of the SQLite database. Created by `python -m holdline.seed`.
HOLDLINE_DB_PATH=holdline.db

# Which agent implementation serves /api/chat: "manual" (Phase 3) or "graph" (Phase 5).
HOLDLINE_AGENT=manual

# Set to "fake" to run the app without an API key using the scripted test client.
HOLDLINE_LLM=anthropic

# structlog level: DEBUG | INFO | WARNING | ERROR
HOLDLINE_LOG_LEVEL=INFO

# Optional: LangSmith tracing (Phase 5). Leave blank to disable.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=holdline
